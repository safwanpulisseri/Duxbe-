{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach V8 Inspector",
      "type": "node",
      "address": "127.0.0.1",
      "request": "attach",
      // This is important: You must enter the path where your edge functions
      // folders are located.
      "localRoot": "${workspaceFolder}/supabase/functions/",
      // CLI mounts all functions under /home/deno/functions
      "remoteRoot": "/home/deno/functions/",
      // As you can see from the two options above, VsCode tries to locate the script
      // paths being used by the inspector session locally by matching local and remote
      // paths.
      //
      // If a valid path cannot be found on either side, or the script contents of
      // those paths do not match each other, the breakpoint setting may not proceed
      // correctly.
      //
      // We set the two options below for this.
      "sourceMaps": true,
      "enableContentValidation": false,
      // Properties below are optional.
      "restart": true,
      "timeout": 1000000,
      // Inspector is accepting sessions on 8083 by default.
      "port": 8083
    },
    {
      "name": "Web Launch development",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "args": [
        "-d",
        "web-server",
        "--target",
        "lib/main_development.dart",
        "--web-port",
        "5000",
        "--web-experimental-hot-reload"
      ]
    },
    {
      "name": "Web Launch staging",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_staging.dart",
      "args": [
        "-d",
        "web-server",
        "--target",
        "lib/main_production.dart",
        "--web-renderer",
        "canvaskit",
        "--web-port",
        "5005",
        "--web-experimental-hot-reload"
      ]
    },
    {
      "name": "Web Launch production",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_production.dart",
      "args": [
        "-d",
        "web-server",
        "--target",
        "lib/main_production.dart",
        "--web-renderer",
        "canvaskit",
        "--web-port",
        "5005",
        "--web-experimental-hot-reload"
      ]
    },
    {
      "name": "Launch development",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "args": [
        "--target",
        "lib/main_development.dart",
        "--flavor",
        "development",
      ]
    },
    {
      "name": "Launch development Release",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "args": [
        "--release",
        "--target",
        "lib/main_development.dart",
        "--flavor",
        "development"
      ]
    },
    {
      "name": "Launch staging",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_staging.dart",
      "args": [
        "--target",
        "lib/main_staging.dart",
        "--flavor",
        "staging"
      ]
    },
    {
      "name": "Launch staging Release",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_staging.dart",
      "args": [
        "--release",
        "--target",
        "lib/main_staging.dart",
        "--flavor",
        "staging"
      ]
    },
    {
      "name": "Launch production",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_production.dart",
      "args": [
        "--target",
        "lib/main_production.dart",
        "--flavor",
        "production"
      ]
    },
    {
      "name": "Launch production Release",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_production.dart",
      "args": [
        "--release",
        "--target",
        "lib/main_production.dart",
        "--flavor",
        "production"
      ]
    },
    {
      "name": "Launch development Mobile",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_mobile.dart",
      "args": [
        "--target",
        "lib/main_mobile.dart",
        "--flavor",
        "development"
      ]
    }
  ]
}